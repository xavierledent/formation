{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/git-sync.mjs\" start",
            "timeout": 90,
            "statusMessage": "Vérification du dépôt avec GitHub…"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/git-sync.mjs\" end",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
